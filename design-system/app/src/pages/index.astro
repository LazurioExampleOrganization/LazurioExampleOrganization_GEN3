---
import "../styles/global.css";
import { readFile } from "node:fs/promises";

const tokenRaw = await readFile(new URL("../../../content/brand/colors/tokens.json", import.meta.url), "utf-8");
const tokens = JSON.parse(tokenRaw);
const colors = tokens.colors ?? {};

const sections = [
  {
    title: "Brand",
    description: "Colors, typography, logo rules and baseline identity.",
    href: "../content/brand/",
  },
  {
    title: "Examples",
    description: "Reviewable references for web, slides, documents and tables.",
    href: "../content/examples/",
  },
  {
    title: "Templates",
    description: "Reusable starters for repeated output formats.",
    href: "../content/templates/",
  },
];
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Design System Viewer</title>
  </head>
  <body>
    <main class="shell">
      <header class="hero">
        <p class="eyebrow">GEN2 design-system</p>
        <h1>{tokens.name ?? "Company"} design baseline</h1>
        <p>
          Read-only viewer for <code>design-system/content/</code>. Authoring
          happens in Git by editing files, not inside this app.
        </p>
      </header>

      <section class="grid" aria-label="Design system sections">
        {sections.map((section) => (
          <article class="card">
            <h2>{section.title}</h2>
            <p>{section.description}</p>
            <code>{section.href}</code>
          </article>
        ))}
      </section>

      <section class="panel">
        <h2>Color Tokens</h2>
        <div class="swatches">
          {Object.entries(colors).map(([name, value]) => (
            <div class="swatch">
              <span class="chip" style={`background:${value}`}></span>
              <div>
                <strong>{name}</strong>
                <code>{value}</code>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
