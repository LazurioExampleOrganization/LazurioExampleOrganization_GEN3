# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Python/Node caches
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/node_modules/
**/.astro/

# Nested Git repositories declared in root modules.manifest.json.
# The root tracks only manifests and docs, never their contents or pointers.
/infra/
/workspace/*/
/productionspace/*/

# Environment files and secrets
**/.env
**/.env.local
**/.env.*.local

# Lockfiles of other package managers. Bun is the package manager, so only
# `bun.lock` is committed. A lockfile from a local `npm i`, `yarn` or
# `pnpm i` never reaches Git and cannot cause drift.
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml

# Per-person Claude Code settings (tokens, MCP session data, OAuth)
company/colleagues/*/.claude/settings.json
company/colleagues/*/.claude/settings.local.json
company/colleagues/*/.claude/session/
company/colleagues/*/.claude/cache/
company/colleagues/*/.claude/auth/

# Per-person scratch
company/colleagues/*/scratch/
company/colleagues/*/.scratch/

# Per-person local archive and private layers
company/colleagues/*/archive/
company/colleagues/*/private/

# Per-person local memory and runtime dumps. Personal agent memory never goes
# to Git; durable insights belong in the right document or module.
company/colleagues/*/memory/
company/colleagues/*/.memory/

# Per-person playgrounds (prototyping data formats)
company/colleagues/*/playgrounds/

# Shared skills: `.agents/skills` is canonical and `.claude/skills` is its
# tracked mirror. Other `.agents` runtime files stay local.
.agents/*
!.agents/skills

# IDE
.idea/
company/colleagues/*/.vscode/settings.json
company/colleagues/*/.vscode/c_cpp_properties.json
.vscode/
.cursor/

# Build output
dist/
build/
.next/
.turbo/

# Task worktrees (`.worktrees/root/<slug>`, `.worktrees/workspace/<module>/<slug>`).
.worktrees/

# Codex CLI local temp and transient worktrees
.codex-tmp/
.claude/worktrees/

# Cloudflare Wrangler local cache
**/.wrangler/

# Local QMD semantic-search config (contains workstation-specific paths).
.config/qmd/

# Design system viewer build artifacts
design-system/app/dist/

# Former guide viewer build output, kept ignored for old checkouts.
/guide/

# Logs
*.log
logs/

# Local continuity diary for unfinished workspace changes.
# Ignored by design; agents must clear completed sections after commit/push/PR.
LOCAL_CHANGES_DIARY.md

output/
.cache/

# Local archives and packaged artifacts. Commit only with explicit
# source-of-truth reason and `git add -f`, preferably via Git LFS or release
# storage.
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tbz2
*.7z
*.rar
*.dmg
*.pkg
*.iso
