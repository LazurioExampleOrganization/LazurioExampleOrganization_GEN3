---
import { readAllTeamAchievements } from "@/lib/profile";
import AchievementBadge from "./AchievementBadge.astro";
import GratulaceForm from "./GratulaceForm.astro";

const items = readAllTeamAchievements();
---

{
  items.length === 0 ? (
    <div class="rounded-xl border border-[var(--surface-border)] bg-[var(--surface-panel)] p-8 text-center">
      <p class="text-[var(--surface-muted)]">
        Zatím nikdo nic neunlockl. Buď první!
      </p>
    </div>
  ) : (
    <ul class="space-y-3">
      {items.map((it) => (
        <li class="rounded-xl border border-[var(--surface-border)] bg-[var(--surface-card)] p-4">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="min-w-0">
              <div class="text-sm text-[var(--surface-muted)]">
                <strong class="text-[var(--surface-fg)] font-medium">{it.jmeno}</strong>{" "}
                · {new Date(it.unlocked_at).toLocaleDateString("cs-CZ")}
                {it.lekce && <span class="opacity-60"> · lekce {it.lekce}</span>}
              </div>
              <div class="mt-2">
                <AchievementBadge achievement={it.achievement} />
              </div>
              {"description" in it.achievement && it.achievement.description && (
                <p class="mt-2 text-sm text-[var(--surface-muted)]">
                  {it.achievement.description}
                </p>
              )}
            </div>
            <details class="text-sm">
              <summary class="cursor-pointer rounded-lg border border-[var(--surface-border)] px-3 py-1.5 hover:bg-[var(--surface-faint)]">
                Pogratulovat 🎉
              </summary>
              <div class="mt-3 w-72">
                <GratulaceForm targetSlug={it.slug} achievementId={it.achievement.id} />
              </div>
            </details>
          </div>
        </li>
      ))}
    </ul>
  )
}
