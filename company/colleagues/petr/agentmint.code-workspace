{
  "//": "Petrův AgentMint workspace. Root je celé super-repo, druhý folder je person overlay.",
  "folders": [
    {
      "name": "AgentMint",
      "path": "../../.."
    },
    {
      "name": "petr",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/build": true,
      "**/.dart_tool": true,
      "**/.flutter-plugins": true,
      "**/.flutter-plugins-dependencies": true,
      "**/.symlinks": true,
      "**/Pods": true,
      "**/.gradle": true,
      "**/target": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/build": true,
      "**/.dart_tool": true,
      "**/.flutter-plugins": true,
      "**/.flutter-plugins-dependencies": true,
      "**/.symlinks/**": true,
      "**/Pods/**": true,
      "**/.gradle/**": true,
      "**/target/**": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.next/**": true,
      "**/.turbo/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/.dart_tool/**": true,
      "**/.symlinks/**": true,
      "**/Pods/**": true,
      "**/.gradle/**": true,
      "**/target/**": true
    },
    "git.autoRepositoryDetection": "subFolders",
    "git.detectSubmodules": true,
    "git.detectSubmodulesLimit": 100,
    "git.repositoryScanMaxDepth": 100,
    "git.openRepositoryInParentFolders": "always"
  },
  "extensions": {
    "recommendations": []
  }
}

