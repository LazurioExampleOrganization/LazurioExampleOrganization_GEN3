---
interface Props {
  targetSlug: string;
  achievementId: string;
}

const { targetSlug, achievementId } = Astro.props;
---

<form
  class="grat-form space-y-2"
  data-target-slug={targetSlug}
  data-achievement={achievementId}
>
  <textarea
    name="text"
    rows="3"
    required
    placeholder="Tvoje gratulace…"
    class="w-full rounded-lg border border-[var(--surface-border)] bg-[var(--surface-bg)] p-2 text-sm"
  ></textarea>
  <div class="flex items-center justify-between">
    <div class="grat-status text-xs text-[var(--surface-muted)]"></div>
    <button
      type="submit"
      class="rounded-lg bg-workspace-700 text-white px-3 py-1.5 text-sm hover:bg-workspace-800"
    >
      Odeslat
    </button>
  </div>
</form>

<script is:inline>
  (() => {
    document.querySelectorAll("form.grat-form").forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return;
      const status = form.querySelector(".grat-status");
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const ta = form.querySelector("textarea");
        const text = ta && "value" in ta ? String(ta.value) : "";
        const targetSlug = form.dataset.targetSlug ?? "";
        const achievementId = form.dataset.achievement ?? "";
        if (!text.trim()) return;
        if (status instanceof HTMLElement) status.textContent = "Odesílám…";
        try {
          const meRes = await fetch("/api/whoami");
          const me = await meRes.json();
          if (!me?.slug) {
            if (status instanceof HTMLElement) {
              status.textContent = "Nejdřív si vyber profil v /profil.";
            }
            return;
          }
          const res = await fetch("/api/achievements/gratulace", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              target_slug: targetSlug,
              achievement_id: achievementId,
              from_slug: me.slug,
              text,
            }),
          });
          if (res.ok) {
            if (status instanceof HTMLElement) status.textContent = "Hotovo. Díky! 🎉";
            if (ta && "value" in ta) ta.value = "";
          } else {
            const err = await res.json().catch(() => ({}));
            if (status instanceof HTMLElement) {
              status.textContent = "Chyba: " + (err.error ?? res.statusText);
            }
          }
        } catch (err) {
          if (status instanceof HTMLElement) status.textContent = "Síťová chyba.";
        }
      });
    });
  })();
</script>
