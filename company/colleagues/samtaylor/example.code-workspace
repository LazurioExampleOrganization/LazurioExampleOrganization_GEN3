{
  "//": "Sam Taylor's Lazurio Example Organization workspace. The first folder is the whole Organization root repository; the second folder is the person overlay.",
  "folders": [
    {
      "name": "Lazurio Example Organization",
      "path": "../../.."
    },
    {
      "name": "samtaylor",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/build": true,
      "**/.dart_tool": true,
      "**/.flutter-plugins": true,
      "**/.flutter-plugins-dependencies": true,
      "**/.symlinks": true,
      "**/Pods": true,
      "**/.gradle": true,
      "**/target": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/build": true,
      "**/.dart_tool": true,
      "**/.flutter-plugins": true,
      "**/.flutter-plugins-dependencies": true,
      "**/.symlinks/**": true,
      "**/Pods/**": true,
      "**/.gradle/**": true,
      "**/target/**": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.next/**": true,
      "**/.turbo/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/.dart_tool/**": true,
      "**/.symlinks/**": true,
      "**/Pods/**": true,
      "**/.gradle/**": true,
      "**/target/**": true
    },
    "git.repositoryScanMaxDepth": 2
  },
  "extensions": {
    "recommendations": []
  }
}
