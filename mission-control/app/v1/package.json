{
  "name": "agentmint-mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "build": "bun build src/server.ts --target=bun --outdir=.build",
    "test": "bun test"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "agentmint-mission-control-v1",
      "title": "Mission Control",
      "company": "LazurioExampleOrganization",
      "module": "mission-control",
      "surface": "internal",
      "dev_script": "dev",
      "build_script": "build",
      "tags": [
        "mission-control",
        "planning"
      ],
      "listeners": [
        {
          "id": "app",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/"
          }
        }
      ]
    }
  }
}
