{
  "//": "Template for a per-person Lazurio Example Organization workspace. When an Organization is created from the template, the file is renamed to the company slug, e.g. example.code-workspace. Copy it to company/colleagues/<you>/ and under 'folders' change the 'name' of the second entry from '_template' to your OS user name. Open it in VS Code or Cursor via File -> Open Workspace from File.",
  "folders": [
    {
      "name": "Lazurio Example Organization",
      "path": "../../.."
    },
    {
      "name": "_template",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/build": true,
      "**/.dart_tool": true,
      "**/.flutter-plugins": true,
      "**/.flutter-plugins-dependencies": true,
      "**/.symlinks": true,
      "**/Pods": true,
      "**/.gradle": true,
      "**/target": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/.turbo": true,
      "**/dist": true,
      "**/build": true,
      "**/.dart_tool": true,
      "**/.flutter-plugins": true,
      "**/.flutter-plugins-dependencies": true,
      "**/.symlinks/**": true,
      "**/Pods/**": true,
      "**/.gradle/**": true,
      "**/target/**": true
    },
    "files.watcherExclude": {
      "**/node_modules/**": true,
      "**/.next/**": true,
      "**/.turbo/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/.dart_tool/**": true,
      "**/.symlinks/**": true,
      "**/Pods/**": true,
      "**/.gradle/**": true,
      "**/target/**": true
    },
    "git.repositoryScanMaxDepth": 2
  },
  "extensions": {
    "recommendations": []
  }
}
